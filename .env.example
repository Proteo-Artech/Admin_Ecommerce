# Copia este archivo a .env en esta misma carpeta y reinicia el panel.
# Los valores de ejemplo son los que usa el código si la variable está vacía.

# Correo de salida. Si SMTP_HOST está vacío, el mensaje solo aparece en la terminal.
SMTP_HOST=
# 587 con SMTP_SECURE=false, o 465 con SMTP_SECURE=true.
# Si la contraseña tiene #, ponla entre comillas.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Distinto <hola@distinto.mx>

# A dónde llegan las compras y los mensajes del formulario de contacto.
ORDER_NOTIFY_EMAIL=pedidos@distinto.mx
CONTACT_EMAIL=hola@distinto.mx

# Pagos. Vacío = el pago se simula y la prenda queda vendida.
# La tienda cobra en su propia página. La llave pública va en Distinto, no aquí.
STRIPE_SECRET_KEY=

# Dirección pública de la tienda. Se usa en los enlaces de recuperación y en Stripe.
STORE_PUBLIC_URL=http://localhost:3000

# Dirección pública del panel. Se usa para las fotos subidas.
ADMIN_PUBLIC_URL=http://localhost:3001

# Secreto para firmar los códigos de verificación. Cámbialo fuera de local.
AUTH_SECRET=

# La misma clave que ADMIN_API_SECRET en el .env de la tienda.
# El panel rechaza el catálogo y el resto de la API de tienda si no coincide.
ADMIN_API_SECRET=

DATABASE_URL="file:../data/distinto.db"
APP_ENV=develop
ALLOW_DEMO_SEED=false
UPLOAD_DIR=
ASSET_PUBLIC_URL=
# Solo para el comando explícito npm run admin:create; no persistir en el VPS.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
